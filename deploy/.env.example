POSTGRES_USER=genwork
POSTGRES_PASSWORD=change-me
POSTGRES_DB=genwork
POSTGRES_PORT=5484

CORE_PORT=8484
CORE_HTTP_ADDR=:8484
DATABASE_URL=postgres://genwork:change-me@postgres:5432/genwork?sslmode=disable

# Registry of the published Genwork images; their tag is the platform version in VERSION (design §2).
GENWORK_IMAGE_REGISTRY=ghcr.io/joaobittencourt1
# GitHub repository whose releases `genwork update` and the updater install; its API is GITHUB_API_URL below.
GENWORK_RELEASE_REPOSITORY=JoaoBittencourt1/Genwork
# Absolute path of this installation. `genwork` writes it on every run, since the updater mounts that path.
GENWORK_HOME=
# Shared secret core presents to the updater (at least 22 characters). `genwork` fills it in, like every empty *_SECRET.
GENWORK_UPDATER_SECRET=
# The updater (rule 84), the only container with the Docker socket; core calls it on the internal network.
UPDATER_HTTP_ADDR=:8093
GENWORK_UPDATER_URL=http://updater:8093
DOCKER_SOCKET_PATH=/var/run/docker.sock
# The gateway on the internal network, where the updater and the MCP server reach the platform.
GATEWAY_INTERNAL_URL=http://gateway:8487

# Public entrypoint (rule 57): the web dev server proxies /api, /.well-known, and /mcp here.
GATEWAY_PORT=8487
CORE_UPSTREAM=http://core:8484
MCP_UPSTREAM=http://mcp:8092
GENTASKS_UPSTREAM=http://gentasks:8090
GENMONITOR_UPSTREAM=http://genmonitor:8091
# The compose network and the gateway's fixed address in it; core trusts X-Forwarded-For only from that address.
GENWORK_NETWORK_SUBNET=10.248.84.0/24
GATEWAY_IPV4=10.248.84.10

# Base URL people open in the browser; invite links and the token issuer use it.
GENWORK_PUBLIC_URL=http://localhost:8485
GENWORK_INSTANCE_NAME=Genwork
GENWORK_DEFAULT_LOCALE=pt-BR

# Base64 Ed25519 seed. `genwork up` / `db` / `api` fill it in on first run; `core keygen` also prints one.
JWT_SIGNING_KEY=

# Shared secret modules present to register with core (at least 22 characters). `genwork up` / `db` / `api` fill it in on first run.
GENWORK_MODULE_SECRET=

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=Genwork <no-reply@genwork.local>
# none | starttls | tls
SMTP_TLS=none
SMTP_USERNAME=
SMTP_PASSWORD=
MAILPIT_UI_PORT=8486

# Comma-separated CIDRs of reverse proxies allowed to set X-Forwarded-For: the gateway only.
TRUSTED_PROXY_CIDRS=10.248.84.10/32

# Gentasks module. Modules call core on the internal network, never through the gateway.
CORE_INTERNAL_URL=http://core:8484
GENTASKS_HTTP_ADDR=:8090
# Password of the gentasks database role, which owns only the gentasks schema (rule 53). `genwork up` / `db` / `api` fill both in on first run.
GENTASKS_DB_PASSWORD=
GENTASKS_DATABASE_URL=
# Encrypts the secrets gentasks receives at runtime, such as the GitHub App's credentials. `genwork up` fills it in; changing it later makes them unreadable.
GENTASKS_ENCRYPTION_KEY=
# GitHub endpoints: the gentasks integration uses both; the release channel uses the API.
GITHUB_WEB_URL=https://github.com
GITHUB_API_URL=https://api.github.com

# Remote MCP server, behind the gateway at /mcp (MCP_UPSTREAM above). It verifies tokens with core's keys at CORE_INTERNAL_URL.
MCP_HTTP_ADDR=:8092

# Genmonitor module: CPU, memory, disk, network, and operating system of the machine running the stack.
GENMONITOR_HTTP_ADDR=:8091
# Where the compose file mounts the host's procfs and root file system inside the genmonitor container.
GENMONITOR_HOST_PROC=/host/proc
GENMONITOR_HOST_ROOT=/host/root
