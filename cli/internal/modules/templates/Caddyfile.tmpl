# Generated by genwork from the installed modules; do not edit. Single public entrypoint (rule 57).
# Caddy replaces any client-sent X-Forwarded-For with the real peer address, which core trusts only from this container.
{
	admin off
	auto_https off
}

:{$GATEWAY_PORT} {
	handle /internal/* {
		respond 404
	}

	handle /api/core/* {
		reverse_proxy {$CORE_UPSTREAM}
	}

	# The MCP server owns its protected resource metadata (rule 7); core answers every other /.well-known path.
	handle /.well-known/oauth-protected-resource* {
		reverse_proxy {$MCP_UPSTREAM}
	}

	handle /.well-known/* {
		reverse_proxy {$CORE_UPSTREAM}
	}

	handle /mcp {
		reverse_proxy {$MCP_UPSTREAM}
	}

	handle /mcp/* {
		reverse_proxy {$MCP_UPSTREAM}
	}
{{range .}}
	handle {{.APIPrefix}}/* {
		reverse_proxy {${{.UpstreamVariable}}}
	}
{{end}}
	handle /api/* {
		respond 404
	}

	# The web app (rule 65). Hashed assets never change, and a missing one answers 404, so HTML is never cached as a script.
	# Client-side routes fall back to index.html, which is revalidated so a new release loads at once.
	# Development images ship no /srv/web, so these answer 404 there and Vite serves the app.
	handle /assets/* {
		root * /srv/web
		@existingAsset file
		header @existingAsset Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv/web
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
